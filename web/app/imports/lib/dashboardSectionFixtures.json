{
  "timeCapsule": [
    {
      "id": "basic",
      "label": "Basic",
      "imageUrl": "/image/TODO.png",
      "config": {
        "withControlWidget": true,
        "id": "time-capsule",
        "widgets": [
          {
            "label": "Map",
            "type": "timeCapsuleMap",
            "layout": {
              "grid": 8,
              "height": 1,
              "chroma": true
            }
          },
          {
            "label": "Robot Log",
            "type": "timeCapsuleAuditLogs",
            "layout": {
              "grid": 4,
              "height": 1,
              "chroma": true
            }
          },
          {
            "label": "Timeline",
            "type": "chart",
            "config": {
              "elementList": ["cpuLoadPercentage", "ramUsagePercentage"],
              "elementValues": {
                "cpuLoadPercentage": {
                  "label": "CPU",
                  "scale": 100
                },
                "ramUsagePercentage": {
                  "label": "RAM",
                  "scale": 100
                }
              },
              "chartType": "linechart",
              "min": 0,
              "max": 100,
              "staticTimeOnly": true
            },
            "layout": {
              "grid": 6,
              "height": 1,
              "chroma": true
            }
          },
          {
            "label": "Network",
            "type": "chart",
            "config": {
              "elementList": ["networkTotalRate", "networkInOrbitRate"],
              "elementValues": {
                "networkTotalRate": {
                  "label": "Network rate"
                },
                "networkInOrbitRate": {
                  "label": "InOrbit network rate"
                }
              },
              "chartType": "linechart",
              "min": 0,
              "max": 100,
              "staticTimeOnly": true
            },
            "layout": {
              "grid": 6,
              "height": 1,
              "chroma": true
            }
          }
        ]
